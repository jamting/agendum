# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# ExDoc's default output folder; `mix docs` writes _build/docs/ instead
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
agenda-*.tar


# The escript binary built by `mix escript.build` (and its name before the rename)
/agendum
/agenda

# Local data files (and their extension before the rename)
*.agendum
*.agendum.tmp
*.agenda
*.agenda.tmp
# except the starter files shipped with Agendum (mix agendum.starters)
!starters/*.agendum
# and the golden files of the file format (mix agendum.golden)
!test/fixtures/formats/*.agendum

# macOS
.DS_Store

# Agenda manuals as PDF (large; see docs/reference/README.md for the source)
docs/reference/*_text.pdf
docs/reference/screens/

# Editor swap files (e.g. vimdiff from a diff viewer)
*.swp
*.swo

# Claude Code settings that are personal (shared skills stay in .claude/skills/)
.claude/settings.local.json

# Python bytecode from the research tools in tools/
__pycache__/
/site
/docs/.obsidian

# Claude Code instructions that are personal (where the owner's private files are)
CLAUDE.local.md

# direnv: personal environment variables for this checkout
.envrc
